# Neurosonancy - Gitignore

# Ambientes Virtuais
venv/
venv_chatterbox/
venv_coqui/
venv_tts/
.venv/
env/

# Arquivos de ambiente
.env

# Pastas de Dados (contém dados do usuario)
data_input/
data_output/
samples/
datasets/
trained_models/

# Modelos TTS/LLM locais: ignora pesos mas versiona estrutura
models/*/
!models/.gitkeep

# Documentacao interna (logs e dev)
docs/logs/
docs/dev/

# Cache Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Build/Dist
build/
dist/
*.egg-info/
*.egg

# IDE/Config
.vscode/
.idea/
*.sublime-*
.gemini/
.claude/

# Sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs de execucao
*.log

# Documentos internos privados
IMPORTANT.MD
GUIDE.md

# Symlink (aponta para docs/logs)
logs

# Checkpoints de treinamento
*.pt
*.pth
*.ckpt
checkpoint*/

# Modelos baixados (grandes demais para git)
*.bin
*.safetensors

# Codigo deprecated
src/modules/clone_voice/core/_deprecated/

# Arquivos externos / gerados / evidencias de IA
KIMI.md
GUIDE.md.backup
Claude-templates/
NEUROSONANCY_*.svg

# --- anti-IA (anonimato local) ---
AGENTS.md
GEMINI.md
COPILOT.md
HANDOFF-PROMPT.md
HANDOFF.md
HOW_TO_RESUME.md
VALIDATOR_BRIEF.md
STATE.md
.cursorrules
.windsurfrules
.cursor/
.aider*
.continue/
.github/copilot-instructions.md

# Symlink local para diretrizes (não vai pro repo)
CLAUDE.md
